id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"gst_liability\": \"<string>\",\n          \"item_tax\": [\n            \"<object>\",\n            \"<object>\"\n          ],\n          \"item_discount\": \"<string>\",\n          \"price\": \"<string>\",\n          \"final_price\": \"<string>\",\n          \"quantity\": \"<string>\",\n          \"description\": \"<string>\",\n          \"variation_name\": \"<string>\",\n          \"variation_id\": \"<string>\",\n          \"AddonItem\": {\n            \"details\": [\n              \"<object>\",\n              \"<object>\"\n            ]\n          }\n        },\n        {\n          \"id\": \"<string>\",\n          \"name\": \"<string>\",\n          \"gst_liability\": \"<string>\",\n          \"item_tax\": [\n            \"<object>\",\n            \"<object>\"\n          ],\n          \"item_discount\": \"<string>\",\n          \"price\": \"<string>\",\n          \"final_price\": \"<string>\",\n          \"quantity\": \"<string>\",\n          \"description\": \"<string>\",\n          \"variation_name\": \"<string>\",\n          \"variation_id\": \"<string>\",\n          \"AddonItem\": {\n            \"details\": [\n              \"<object>\",\n              \"<object>\"\n            ]\n          }\n        }\n      ],\n      \"Tax\": [\n        \"<object>\",\n        \"<object>\"\n      ],\n      \"Discount\": [\n        \"<object>\",\n        \"<object>\"\n      ]\n    }\n  },\n  \"udid\": \"<string>\",\n  \"device_type\": \"<string>\"\n}",
